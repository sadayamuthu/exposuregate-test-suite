{
  "id": "eg-unsupported-lockfile",
  "category": "policy",
  "summary": "The change adds a yarn.lock, which ExposureGate can't parse. It warns (policy.unsupported_lockfile) instead of passing silently.",
  "source": null,
  "git": true,
  "modes": [
    "pr"
  ],
  "delete": [],
  "data": "frozen",
  "args": [
    "--as-of",
    "2026-11-13",
    "--max-age-days",
    "200"
  ],
  "expect": {
    "verdict": "WARN",
    "exit_code": 0,
    "denials": [],
    "findings": [
      {
        "reason": "unsupported_lockfile",
        "action": "warn"
      }
    ],
    "lockfiles": {
      "yarn.lock": "unsupported"
    }
  }
}
